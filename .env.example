# 本機開發：複製成 .env。cPanel 上：在 Setup Node.js App 的 Environment variables 逐一新增。

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 管理者 Email，逗號分隔（decision 12）
ADMIN_EMAILS=

SMTP_HOST=mail.inwave-studio.com
SMTP_PORT=465
SMTP_USER=noreply@inwave-studio.com
SMTP_PASSWORD=
SMTP_FROM=文化扭蛋機 <noreply@inwave-studio.com>

# LINE Login（decision 31）。兩個都空白時，登入頁只顯示 Email 登入。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 選填：要跟 LINE Developers 登記的 Callback URL 完全一樣。不填就用目前網址組出 /api/auth/line/callback
LINE_CALLBACK_URL=

# 本機沒有 SMTP 時設 1：驗證碼印在終端機而不寄出。主機上不要設。
MAIL_DEV_LOG=
